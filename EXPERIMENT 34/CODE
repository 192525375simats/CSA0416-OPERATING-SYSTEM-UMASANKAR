#include <stdio.h>
#include <stdlib.h>
struct Record { int recordNumber; char data[256]; };
int main(void) {
    FILE *file;
    struct Record record;
    int recordNumber;
    file = fopen("sequential_file.dat", "wb");
    if (file == NULL) { perror("Unable to create file"); return 1; }
    printf("Enter records (enter 0 as record number to finish):\n");
    while (1) {
        printf("Record Number: ");
        if (scanf("%d", &record.recordNumber) != 1) { fclose(file); return 1; }
        if (record.recordNumber == 0) break;
        printf("Data: ");
        scanf(" %255[^\n]", record.data);
        if (fwrite(&record, sizeof(record), 1, file) != 1) {
            perror("fwrite"); fclose(file); return 1;
        }
    }
    fclose(file);
    file = fopen("sequential_file.dat", "rb");
    if (file == NULL) { perror("Unable to open file"); return 1; }
    while (1) {
        int found = 0;
        printf("Enter record number to read (0 to exit): ");
        if (scanf("%d", &recordNumber) != 1) break;
        if (recordNumber == 0) break;
        rewind(file);
        while (fread(&record, sizeof(record), 1, file) == 1) {
            printf("Record Number: %d\n", record.recordNumber);
            printf("Data: %s\n", record.data);
            if (record.recordNumber == recordNumber) { found = 1; break; }
        }
        if (!found) printf("Record not found.\n");
    }
    fclose(file);
    return 0;
}