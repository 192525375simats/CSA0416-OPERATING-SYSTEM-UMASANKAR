#include <stdio.h>
#define MAX_MEMORY 1000
int memory[MAX_MEMORY];
void initializeMemory(void) {
    int i;
    for (i = 0; i < MAX_MEMORY; i++) memory[i] = -1;
}
void displayMemory(void) {
    int i = 0;
    printf("\nMemory Status:\n");
    while (i < MAX_MEMORY) {
        if (memory[i] == -1) {
            int start = i;
            while (i < MAX_MEMORY && memory[i] == -1) i++;
            printf("Free block: %d - %d (%d units)\n", start, i - 1, i - start);
        } else {
            int process = memory[i], start = i;
            while (i < MAX_MEMORY && memory[i] == process) i++;
            printf("Process %d: %d - %d\n", process, start, i - 1);
        }
    }
}
void allocateBestFit(int processId, int size) {
    int i = 0, bestStart = -1, bestSize = MAX_MEMORY + 1;
    while (i < MAX_MEMORY) {
        if (memory[i] == -1) {
            int start = i;
            while (i < MAX_MEMORY && memory[i] == -1) i++;
            if (i - start >= size && i - start < bestSize) {
                bestStart = start; bestSize = i - start;
            }
        } else i++;
    }
    if (bestStart == -1) {
        printf("Process %d cannot be allocated.\n", processId); return;
    }
    for (i = bestStart; i < bestStart + size; i++) memory[i] = processId;
    printf("Process %d allocated from %d to %d using Best Fit.\n",
           processId, bestStart, bestStart + size - 1);
}
int main(void) {
    initializeMemory();
    allocateBestFit(1, 200);
    allocateBestFit(2, 300);
    allocateBestFit(3, 100);
    displayMemory();
    return 0;
}