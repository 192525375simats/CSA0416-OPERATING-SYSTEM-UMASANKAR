#include <stdio.h>
#include <pthread.h>
#include <semaphore.h>
#include <unistd.h>
 
#define MAXT 20
 
sem_t mutex;      /* protects readcount                    */
sem_t wrt;        /* exclusive access to the shared data   */
int readcount = 0;
int data = 0;     /* shared resource                       */
 
void *reader(void *arg) {
    int id = *(int *)arg;
 
    sem_wait(&mutex);
    readcount++;
    if (readcount == 1) sem_wait(&wrt);   /* first reader locks out writers */
    sem_post(&mutex);
 
    printf("Reader %d is reading data = %d   (readers active: %d)\n", id, data, readcount);
    usleep(200000);
 
    sem_wait(&mutex);
    readcount--;
    printf("Reader %d finished reading\n", id);
    if (readcount == 0) sem_post(&wrt);   /* last reader lets writers in */
    sem_post(&mutex);
    return NULL;
}
 
void *writer(void *arg) {
    int id = *(int *)arg;
 
    sem_wait(&wrt);
    data++;
    printf("Writer %d wrote data = %d\n", id, data);
    usleep(200000);
    sem_post(&wrt);
    return NULL;
}
 
int main() {
    int nr, nw, rid[MAXT], wid[MAXT];
    pthread_t r[MAXT], w[MAXT];
 
    printf("Enter number of readers and writers (max %d each): ", MAXT);
    scanf("%d %d", &nr, &nw);
    if (nr < 0 || nr > MAXT || nw < 0 || nw > MAXT) { printf("Invalid count\n"); return 1; }
 
    sem_init(&mutex, 0, 1);
    sem_init(&wrt, 0, 1);
 
    for (int i = 0; i < nr || i < nw; i++) {
        if (i < nr) { rid[i] = i + 1; pthread_create(&r[i], NULL, reader, &rid[i]); }
        if (i < nw) { wid[i] = i + 1; pthread_create(&w[i], NULL, writer, &wid[i]); }
        usleep(50000);
    }
    for (int i = 0; i < nr; i++) pthread_join(r[i], NULL);
    for (int i = 0; i < nw; i++) pthread_join(w[i], NULL);
 
    printf("Final value of data = %d\n", data);
    sem_destroy(&mutex);
    sem_destroy(&wrt);
    return 0;
}
 
