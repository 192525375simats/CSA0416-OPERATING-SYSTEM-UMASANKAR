#include <stdio.h>
#include <stdlib.h>
int mutex = 1;
int full = 0;
int empty = 10;
int item = 0;
void producer(void) {
    --mutex; ++full; --empty; ++item;
    printf("Producer produces item %d\n", item);
    ++mutex;
}
void consumer(void) {
    --mutex; --full; ++empty;
    printf("Consumer consumes item %d\n", item);
    --item; ++mutex;
}
int main(void) {
    int choice;
    while (1) {
        printf("\n1. Producer\n2. Consumer\n3. Exit\n");
        printf("Enter your choice: ");
        if (scanf("%d", &choice) != 1) return 1;
        switch (choice) {
            case 1:
                if (mutex == 1 && empty != 0) producer();
                else printf("Buffer is full!\n");
                break;
            case 2:
                if (mutex == 1 && full != 0) consumer();
                else printf("Buffer is empty!\n");
                break;
            case 3: exit(0);
            default: printf("Invalid choice.\n");
        }
    }
    return 0;
}