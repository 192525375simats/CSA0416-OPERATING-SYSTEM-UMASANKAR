#include <stdio.h>
#define MAX_FRAMES 3
void printFrames(int frames[]) {
    int i;
    for (i = 0; i < MAX_FRAMES; i++)
        if (frames[i] == -1) printf(" - "); else printf(" %d ", frames[i]);
    printf("\n");
}
int main(void) {
    int referenceString[] = {7,0,1,2,0,3,0,4,2,3,0,3,2};
    int n = sizeof(referenceString) / sizeof(referenceString[0]);
    int frames[MAX_FRAMES] = {-1,-1,-1};
    int pageFaults = 0, i, j, k, found, replaceIndex, farthest, nextUse;
    printf("Reference String: ");
    for (i = 0; i < n; i++) printf("%d ", referenceString[i]);
    printf("\n\nOptimal Page Replacement:\n");
    for (i = 0; i < n; i++) {
        found = 0;
        for (j = 0; j < MAX_FRAMES; j++)
            if (frames[j] == referenceString[i]) { found = 1; break; }
        if (found) { printf("Page %d -> Hit\n", referenceString[i]); continue; }
        replaceIndex = -1;
        for (j = 0; j < MAX_FRAMES; j++)
            if (frames[j] == -1) { replaceIndex = j; break; }
        if (replaceIndex == -1) {
            farthest = -1;
            for (j = 0; j < MAX_FRAMES; j++) {
                nextUse = n + 1;
                for (k = i + 1; k < n; k++)
                    if (referenceString[k] == frames[j]) { nextUse = k; break; }
                if (nextUse > farthest) { farthest = nextUse; replaceIndex = j; }
            }
        }
        frames[replaceIndex] = referenceString[i];
        pageFaults++;
        printf("Page %d -> ", referenceString[i]);
        printFrames(frames);
    }
    printf("\nTotal Page Faults: %d\n", pageFaults);
    return 0;
}