#include <stdio.h>
#define MAXP 10
#define MAXR 10
 
int n, m;
int alloc[MAXP][MAXR], max[MAXP][MAXR], need[MAXP][MAXR], avail[MAXR];
 
/* Safety algorithm: returns 1 if system is in a safe state */
int isSafe(int print) {
    int work[MAXR], fin[MAXP] = {0}, seq[MAXP], cnt = 0;
    for (int j = 0; j < m; j++) work[j] = avail[j];
 
    while (cnt < n) {
        int found = 0;
        for (int i = 0; i < n; i++) {
            if (fin[i]) continue;
            int j;
            for (j = 0; j < m; j++)
                if (need[i][j] > work[j]) break;
            if (j == m) {
                for (int k = 0; k < m; k++) work[k] += alloc[i][k];
                seq[cnt++] = i;
                fin[i] = 1;
                found = 1;
            }
        }
        if (!found) return 0;
    }
    if (print) {
        printf("Safe sequence: ");
        for (int i = 0; i < n; i++) printf("P%d%s", seq[i], i < n - 1 ? " -> " : "\n");
    }
    return 1;
}
 
int main() {
    int i, j;
    printf("Enter number of processes and resource types: ");
    scanf("%d %d", &n, &m);
 
    printf("Enter Allocation matrix (%d x %d):\n", n, m);
    for (i = 0; i < n; i++) for (j = 0; j < m; j++) scanf("%d", &alloc[i][j]);
    printf("Enter Max matrix (%d x %d):\n", n, m);
    for (i = 0; i < n; i++) for (j = 0; j < m; j++) scanf("%d", &max[i][j]);
    printf("Enter Available vector (%d values): ", m);
    for (j = 0; j < m; j++) scanf("%d", &avail[j]);
 
    for (i = 0; i < n; i++) for (j = 0; j < m; j++) need[i][j] = max[i][j] - alloc[i][j];
 
    printf("\nProcess  Allocation  Max  Need\n");
    for (i = 0; i < n; i++) {
        printf("P%d       ", i);
        for (j = 0; j < m; j++) printf("%d ", alloc[i][j]);
        printf("      ");
        for (j = 0; j < m; j++) printf("%d ", max[i][j]);
        printf("   ");
        for (j = 0; j < m; j++) printf("%d ", need[i][j]);
        printf("\n");
    }
 
    if (isSafe(1)) printf("System is in a SAFE state\n");
    else { printf("System is in an UNSAFE state (deadlock possible)\n"); return 0; }
 
    /* Resource-request algorithm */
    int ch, p, req[MAXR];
    printf("\nMake a resource request? (1 = yes, 0 = no): ");
    scanf("%d", &ch);
    if (ch) {
        printf("Enter process number (0-%d): ", n - 1);
        scanf("%d", &p);
        printf("Enter request vector (%d values): ", m);
        for (j = 0; j < m; j++) scanf("%d", &req[j]);
 
        for (j = 0; j < m; j++)
            if (req[j] > need[p][j]) { printf("Error: process has exceeded its maximum claim\n"); return 0; }
        for (j = 0; j < m; j++)
            if (req[j] > avail[j]) { printf("P%d must wait: resources not available\n", p); return 0; }
 
        /* pretend to allocate */
        for (j = 0; j < m; j++) { avail[j] -= req[j]; alloc[p][j] += req[j]; need[p][j] -= req[j]; }
        if (isSafe(1)) printf("Request can be GRANTED immediately\n");
        else {
            for (j = 0; j < m; j++) { avail[j] += req[j]; alloc[p][j] -= req[j]; need[p][j] += req[j]; }
            printf("Request cannot be granted: it would leave the system UNSAFE\n");
        }
    }
    return 0;
}
 
