#include <stdio.h>

int main()
{
    int n, i;
    int burst[20], waiting[20], turnaround[20], completion[20];
    float avg_waiting = 0, avg_turnaround = 0;

    printf("Enter number of processes: ");
    scanf("%d", &n);

    printf("Enter burst time for each process:\n");

    for (i = 0; i < n; i++)
    {
        printf("P%d: ", i + 1);
        scanf("%d", &burst[i]);
    }

    // First process starts at time 0
    waiting[0] = 0;

    // Calculate waiting time
    for (i = 1; i < n; i++)
    {
        waiting[i] = waiting[i - 1] + burst[i - 1];
    }

    // Calculate completion and turnaround time
    for (i = 0; i < n; i++)
    {
        completion[i] = waiting[i] + burst[i];
        turnaround[i] = completion[i];
    }

    printf("\nProcess\tBurst Time\tWaiting Time\tTurnaround Time\n");

    for (i = 0; i < n; i++)
    {
        printf("P%d\t%d\t\t%d\t\t%d\n",
               i + 1, burst[i], waiting[i], turnaround[i]);

        avg_waiting += waiting[i];
        avg_turnaround += turnaround[i];
    }

    avg_waiting /= n;
    avg_turnaround /= n;

    printf("\nAverage Waiting Time    = %.2f", avg_waiting);
    printf("\nAverage Turnaround Time = %.2f\n", avg_turnaround);

    return 0;
}
