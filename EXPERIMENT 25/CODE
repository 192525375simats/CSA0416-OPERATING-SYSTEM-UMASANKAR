#include <stdio.h>
#include <stdlib.h>
#include <fcntl.h>
#include <unistd.h>
#include <sys/stat.h>
#include <dirent.h>
int main(void) {
    int fd;
    char buffer[100] = {0};
    struct stat fileInfo;
    DIR *directory;
    struct dirent *entry;
    fd = open("foo.txt", O_CREAT | O_RDWR, 0644);
    if (fd == -1) { perror("open"); return 1; }
    if (write(fd, "UNIX I/O system calls", 21) == -1) {
        perror("write"); close(fd); return 1;
    }
    if (lseek(fd, 0, SEEK_SET) == -1) {
        perror("lseek"); close(fd); return 1;
    }
    if (read(fd, buffer, 21) == -1) {
        perror("read"); close(fd); return 1;
    }
    printf("File content: %s\n", buffer);
    if (fcntl(fd, F_GETFL) != -1)
        printf("fcntl: file status flags obtained successfully.\n");
    close(fd);
    if (stat("foo.txt", &fileInfo) == 0)
        printf("File size: %ld bytes\n", (long)fileInfo.st_size);
    else perror("stat");
    directory = opendir(".");
    if (directory == NULL) { perror("opendir"); return 1; }
    printf("Directory contents:\n");
    while ((entry = readdir(directory)) != NULL) printf("%s\n", entry->d_name);
    closedir(directory);
    return 0;
}