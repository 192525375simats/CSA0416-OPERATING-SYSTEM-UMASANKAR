
#include <stdio.h>
#include <stdlib.h>
#include <unistd.h>
#include <sys/ipc.h>
#include <sys/shm.h>
#include <sys/wait.h>

int main() {
    int shmid;
    int *shared;

    shmid = shmget(IPC_PRIVATE, sizeof(int),
                   IPC_CREAT | 0600);

    if (shmid < 0) {
        perror("shmget");
        return 1;
    }

    shared = (int *)shmat(shmid, NULL, 0);

    if (shared == (void *)-1) {
        perror("shmat");
        shmctl(shmid, IPC_RMID, NULL);
        return 1;
    }

    *shared = 0;

    pid_t pid = fork();

    if (pid < 0) {
        perror("fork");
        shmdt(shared);
        shmctl(shmid, IPC_RMID, NULL);
        return 1;
    }

    if (pid == 0) {
        *shared = 100;
        printf("Child wrote: %d\n", *shared);
        shmdt(shared);
        _exit(0);
    } else {
        wait(NULL);
        printf("Parent read: %d\n", *shared);
        shmdt(shared);
        shmctl(shmid, IPC_RMID, NULL);
    }

    return 0;
}
