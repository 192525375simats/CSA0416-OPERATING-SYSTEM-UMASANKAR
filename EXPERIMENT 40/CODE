#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>
#include <sys/stat.h>
int main(){char*name="file.txt";int f=open(name,O_CREAT|O_WRONLY,0644);if(f<0){perror("open");return 1;}write(f,"Permission demo\\n",17);close(f);if(chmod(name,S_IRUSR|S_IWUSR|S_IRGRP|S_IROTH)){perror("chmod");return 1;}struct stat s;if(!stat(name,&s))printf("Permissions changed. Mode: %04o\\n",s.st_mode&0777);return 0;}